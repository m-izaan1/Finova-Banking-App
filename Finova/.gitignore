# ===========================
# Finova Banking App — Monorepo .gitignore
# Stack: NestJS + Prisma + PostgreSQL | Flutter
# ===========================


# ──────────────────────────────
# Node / NestJS (backend/)
# ──────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Compiled output
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Test coverage
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Temp
.temp/
.tmp/


# ──────────────────────────────
# Prisma
# ──────────────────────────────

# Generated Prisma client (re-generated on install)
generated/prisma


# ──────────────────────────────
# Environment & Secrets
# ──────────────────────────────

.env
.env.*
!.env.example


# ──────────────────────────────
# Flutter / Dart (mobile/)
# ──────────────────────────────

# Flutter tool cache
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Dart/Pub packages
.pub-cache/
.pub/

# Build outputs
mobile/build/
mobile/android/.gradle/
mobile/android/captures/
mobile/android/local.properties
mobile/android/key.properties
mobile/android/app/debug.keystore
mobile/android/app/release.keystore
mobile/android/app/upload-keystore.jks
mobile/ios/.symlinks/
mobile/ios/Pods/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Runner.xcworkspace/
mobile/windows/flutter/generated_plugin_registrant.cc
mobile/windows/flutter/generated_plugin_registrant.h
mobile/windows/flutter/generated_plugins.cmake
mobile/web/

# Coverage
mobile/.dart_tool/

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# Xcode
mobile/ios/Pods/
*.xcworkspace
xcuserdata/


# ──────────────────────────────
# OS
# ──────────────────────────────

.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini


# ──────────────────────────────
# IDEs & Editors
# ──────────────────────────────

# VSCode (keep shared settings, ignore personal ones)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains
.idea/
*.launch
.project
.classpath
.c9/
.settings/
*.sublime-workspace
